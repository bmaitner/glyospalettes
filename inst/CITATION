citHeader("To cite glyospalettes in publications, please use the reference below and credit the designers of the colorways you used (see ?glyos_credit):")

year <- sub("-.*", "", meta$`Date/Publication`)
if (is.null(year) || length(year) == 0L || is.na(year)) year <- format(Sys.Date(), "%Y")

bibentry(
  bibtype = "Manual",
  title   = "glyospalettes: Color Palettes Inspired by Glyos Colorways",
  author  = person("Brian", "Maitner"),
  year    = year,
  note    = paste("R package version", meta$Version),
  url     = "https://bmaitner.github.io/glyospalettes/",
  textVersion = paste0(
    "Maitner, B. (", year, "). glyospalettes: Color Palettes Inspired by Glyos ",
    "Colorways. R package version ", meta$Version, ". ",
    "https://bmaitner.github.io/glyospalettes/"
  )
)
